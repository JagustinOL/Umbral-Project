# Copia a .env y ajusta la IP si usas Expo Go en telefono fisico:
#   copy .env.example .env
#
# localhost = PC o emulador web. En telefono fisico usa la IPv4 Wi-Fi de tu PC (ipconfig).
# Ejemplo telefono: http://192.168.68.110:5200

EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8081
EXPO_PUBLIC_KEYCLOAK_REALM=umbral-realm
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=umbral-player-mobile
EXPO_PUBLIC_KEYCLOAK_CLIENT_SECRET=

EXPO_PUBLIC_USER_API_URL=http://localhost:5200
EXPO_PUBLIC_MISSION_API_URL=http://localhost:5200
EXPO_PUBLIC_SESSION_API_URL=http://localhost:5200
EXPO_PUBLIC_SCORING_API_URL=http://localhost:5200

# Emulador Android (AVD): sustituye localhost por 10.0.2.2
